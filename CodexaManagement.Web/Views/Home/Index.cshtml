
@{
    ViewData["Title"] = "Dashboard";
    var usercount = ViewBag.User;
    // var rolecount = ViewBag.RoleCount;
}

<div class="mb-4">
    <h2 class="fw-bold mb-1">Welcome to StaffManagement</h2>
    <p class="text-muted">
        Here's an overview of your workspace.
    </p>
</div>
@if (User.IsInRole("Admin"))
{
    <h5 class="fw-semibold mb-3">Administration Overview</h5>

    <div class="row g-4 mb-4">

        <!-- Total Users -->
        <div class="col-12 col-md-6 col-xl-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <div class="text-muted small">Total Users</div>
                    <h3 class="fw-bold mt-2">@(ViewBag.User ?? 0)</h3>
                    <p class="text-muted small mb-0">Total user accounts</p>
                </div>
            </div>
        </div>

        <!-- Total Employees -->
        <div class="col-12 col-md-6 col-xl-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <div class="text-muted small">Total Employees</div>
                    <h3 class="fw-bold mt-2">@(ViewBag.TotalEmployees ?? 0)</h3>
                    <p class="text-muted small mb-0">Registered employees</p>
                </div>
            </div>
        </div>

        <!-- Total Roles -->
        <div class="col-12 col-md-6 col-xl-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <div class="text-muted small">Total Roles</div>
                    <h3 class="fw-bold mt-2">@(ViewBag.RoleCount ?? 0)</h3>
                    <p class="text-muted small mb-0">Available application roles</p>
                </div>
            </div>
        </div>

        @* <!-- Inactive Users -->
        <div class="col-12 col-md-6 col-xl-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <div class="text-muted small">Inactive Users</div>
                    <h3 class="fw-bold mt-2">@(ViewBag.InactiveUsers ?? 0)</h3>
                    <p class="text-muted small mb-0">Inactive user accounts</p>
                </div>
            </div>
        </div>

        <!-- Recent Users -->
        <div class="col-12 col-md-6 col-xl-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <div class="text-muted small">Recent Users</div>
                    <h3 class="fw-bold mt-2">@(ViewBag.RecentUsers ?? 0)</h3>
                    <p class="text-muted small mb-0">Added in the last 7 days</p>
                </div>
            </div>
        </div> *@

    </div>
}
@if (User.IsInRole("HR") || User.IsInRole("Manager"))
{
    <h5 class="fw-semibold mb-3">Employee Overview</h5>


<div class="row g-4 mb-4">

    <!-- Total Employees -->
    <div class="col-12 col-md-6 col-xl-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-4">
                <div class="text-muted small">Total</div>
                <h3 class="fw-bold mt-2">@usercount</h3>
                <p class="text-muted small mb-0">
                    Registered employees
                </p>
            </div>
        </div>
    </div>

    <!-- Active Employees -->
    <div class="col-12 col-md-6 col-xl-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-4">
                <div class="text-muted small">Active Employees</div>
                <h3 class="fw-bold mt-2">@ViewBag.TotalEmployees</h3>
                <p class="text-muted small mb-0">
                    Currently active employees
                </p>
            </div>
        </div>
    </div>

    <!-- active Employees -->
    <div class="col-12 col-md-6 col-xl-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-4">
                <div class="text-muted small">InActive Employees</div>
                <h3 class="fw-bold mt-2">@(  ViewBag.InactiveEmployees ?? 0)</h3>
                <p class="text-muted small mb-0">
                    Currently active employees
                </p>
            </div>
        </div>
    </div>

    <!-- Recent Employees -->
    @* <div class="col-12 col-md-6 col-xl-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-4">
                <div class="text-muted small">Recent Employees</div>
                <h3 class="fw-bold mt-2">@(ViewBag.RecentEmployees ?? 0)</h3>
                <p class="text-muted small mb-0">
                    Created within the last 7 days
                </p>
            </div>
        </div>
    </div> *@

</div>

}

@if (User.IsInRole("User"))
{
    <h5 class="fw-semibold mb-3">My Workspace</h5>

    <div class="row g-4">
        <div class="col-12 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <i class="bi bi-person-circle fs-3 text-primary"></i>
                    <h5 class="fw-semibold mt-3">My Profile</h5>
                    <p class="text-muted">
                        View your personal account details.
                    </p>
                    <a asp-controller="Account"
                       asp-action="Index"
                       class="btn btn-outline-primary">
                        View Profile
                    </a>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <i class="bi bi-card-text fs-3 text-primary"></i>
                    <h5 class="fw-semibold mt-3">
                        My Employee Information
                    </h5>
                    <p class="text-muted">
                        View the employee information linked to your account.
                    </p>
                    <a asp-controller="Employee"
                       asp-action="UpdateMyDetails"
                       class="btn btn-outline-primary">
                        <i class="bi bi-pencil-square me-2"></i>
                        Edit My Details
                    </a>

                </div>
            </div>
        </div>
    </div>
}
