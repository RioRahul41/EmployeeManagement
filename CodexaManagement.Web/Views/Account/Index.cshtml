
@{
    ViewData["Title"] = "Welcome";
}

<div style="max-width: 850px; margin: 50px auto; font-family: Arial, sans-serif;">

    <div style="background: linear-gradient(135deg, #1e3a8a, #2563eb);
                color: white; padding: 40px; border-radius: 16px;
                box-shadow: 0 8px 24px rgba(0,0,0,0.15);">

        <h1>Welcome, @ViewBag.FirstName! 👋</h1>

        <p style="font-size: 18px; margin-top: 15px;">
            We're glad to have you back.
        </p>

        <hr style="border-color: rgba(255,255,255,0.4);" />

        <p>
            <strong>Full Name:</strong> @ViewBag.FullName
        </p>
        <p>
            <strong>Your Role:</strong> @ViewBag.Role
        </p>

        <p>
            You have successfully logged in to Staff Management.
        </p>

        <form asp-controller="Account"
              asp-action="Logout"
              method="post"
              style="margin-top: 25px;">

            @Html.AntiForgeryToken()

            <button type="submit"
                    style="background: white; color: #1e3a8a;
                           border: none; padding: 12px 24px;
                           border-radius: 8px; cursor: pointer;
                           font-weight: bold;">
                Logout
            </button>
        </form>

    </div>

</div>
