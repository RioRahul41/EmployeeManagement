
@{
    ViewData["Title"] = "User Created Successfully";
}

<div class="container mt-5">
    <div class="card shadow mx-auto" style="max-width: 550px;">
        <div class="card-body text-center p-5">

            <div class="mb-3">
                <i class="bi bi-check-circle-fill text-success"
                   style="font-size: 60px;"></i>
            </div>

            <h2 class="text-success mb-3">
                User Created Successfully!
            </h2>

            <p class="text-muted">
                The new employee account has been created successfully.
            </p>

            @if (TempData["LoginUserName"] != null)
            {
                <div class="alert alert-info text-start">
                    <strong>Email:</strong>
                    @TempData["LoginUserName"]
                </div>
            }

            @if (TempData["TemporaryPassword"] != null)
            {
                <div class="alert alert-warning text-start">
                    <strong>
                        <i class="bi bi-key-fill me-2"></i>
                        Temporary Password
                    </strong>

                    <div class="mt-2">
                        <code>@TempData["TemporaryPassword"]</code>
                    </div>

                    <small class="d-block mt-2">
                        Copy this password and provide it securely
                        to the employee.
                    </small>
                </div>
            }

            <div class="d-flex justify-content-center gap-2 mt-4">
                <a asp-controller="Account"
                   asp-action="Create"
                   class="btn btn-primary">
                    Create Another User
                </a>

                <a asp-controller="Account"
                   asp-action="Index"
                   class="btn btn-outline-secondary">
                    Dashboard
                </a>
            </div>

        </div>
    </div>
</div>
