
@model IReadOnlyList<CodexaManagement.Model.Entities.LeaveRequest>

@using CodexaManagement.Model.Entities
@using CodexaManagement.Model.Enum

@{
    ViewData["Title"] = "Leave Requests";

    var pendingRequests =
        ViewBag.PendingRequests as IEnumerable<LeaveRequest>
        ?? Enumerable.Empty<LeaveRequest>();

    int pendingCount = ViewBag.PendingCount ?? 0;
}

<div class="mb-4">
    <h2 class="fw-bold mb-1">Leave Requests</h2>
    <p class="text-muted mb-0">
        Review employee requests and their supporting documents.
    </p>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

@* Pending notification *@
@if (User.IsInRole("HR") || User.IsInRole("Manager") && pendingCount > 0)
{
    <div class="alert alert-warning d-flex justify-content-between align-items-center">
        <div>
            <strong>@pendingCount pending leave request(s)!</strong>
            <div>Please review the employee leave requests.</div>
        </div>

        <button type="button"
                class="btn btn-warning btn-sm"
                data-bs-toggle="modal"
                data-bs-target="#pendingLeaveModal">
            View pending
        </button>
    </div>

    @* Pending requests popup *@
    <div class="modal fade" id="pendingLeaveModal"
         tabindex="-1" aria-labelledby="pendingLeaveModalLabel"
         aria-hidden="true">

        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">

                <div class="modal-header bg-warning">
                    <h5 class="modal-title" id="pendingLeaveModalLabel">
                        Pending Leave Requests (@pendingCount)
                    </h5>

                    <button type="button" class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <div class="table-responsive">
                        <table class="table table-bordered align-middle">
                            <thead>
                                <tr>
                                    <th>Employee</th>
                                    <th>Leave Type</th>
                                    <th>Dates</th>
                                    <th></th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var request in pendingRequests)
                                {
                                    <tr>
                                        <td>
                                            @request.Employee.FirstName
                                            @request.Employee.LastName
                                        </td>

                                        <td>@request.LeaveType</td>

                                        <td>
                                            @request.FromDate.ToString("d MMM yyyy")
                                            -
                                            @request.ToDate.ToString("d MMM yyyy")
                                        </td>

                                        <td>
                                            <a asp-action="Review"
                                               asp-route-id="@request.Id"
                                               class="btn btn-sm btn-primary">
                                                Review
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Close
                    </button>
                </div>

            </div>
        </div>
    </div>
}

@* Filters *@
<div class="row mb-3 align-items-end">

    <div class="col-md-4 mb-2">
        <label class="form-label">Leave Type</label>
        <select id="leaveTypeFilter" class="form-select">
            <option value="">All Leave Types</option>
            <option value="Annual">Annual</option>
            <option value="Sick">Sick</option>
            <option value="Casual">Casual</option>
            <option value="Unpaid">Unpaid</option>
        </select>
    </div>

    <div class="col-md-4 mb-2">
        <label class="form-label">Status</label>
        <select id="statusFilter" class="form-select">
            <option value="">All Statuses</option>
            <option value="Pending">Pending</option>
            <option value="Approved">Approved</option>
            <option value="Rejected">Rejected</option>
        </select>
    </div>

    <div class="col-md-2 mb-2">
        <button type="button" id="clearFilters"
                class="btn btn-primary">
            <i class="bi bi-x-circle me-1"></i>Clear
        </button>
    </div>

</div>

@* All leave requests *@
<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table id="leaveRequestsTable"
               class="table align-middle mb-0">

            <thead>
                <tr>
                    <th>Employee</th>
                    <th>Leave type</th>
                    <th>Dates</th>
                    <th>Submitted</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var request in Model)
                {
                    <tr>
                        <td>
                            <div class="fw-semibold">
                                @request.Employee.FirstName
                                @request.Employee.LastName
                            </div>
                            <small class="text-muted">
                                @request.Employee.Email
                            </small>
                        </td>

                        <td>@request.LeaveType</td>

                        <td data-order="@request.FromDate.ToString("yyyy-MM-dd")">
                            @request.FromDate.ToString("d MMM yyyy")
                            –
                            @request.ToDate.ToString("d MMM yyyy")
                        </td>

                        <td data-order="@request.AppliedDate.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")">
                            @request.AppliedDate.ToLocalTime().ToString("d MMM yyyy")
                        </td>

                        <td>
                            <span class="badge @(request.Status == LeaveRequestStatus.Approved
                                                                ? "bg-success"
                                                                : request.Status == LeaveRequestStatus.Rejected
                                                                    ? "bg-danger"
                                                                    : "bg-warning text-dark")">
                                @request.Status
                            </span>
                        </td>

                        <td class="text-end">
                            <div class="d-flex justify-content-end gap-2">

                                @* View button *@
                                <a asp-action="Review"
                                   asp-route-id="@request.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    View
                                </a>

                                @if (User.IsInRole("Manager") )
                                {
                                    @* Approve button *@
                                    <form asp-controller="Leave"
                                          asp-action="Approve"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@request.Id" />

                                        <button type="submit"
                                                class="btn btn-sm btn-success"
                                                disabled="@(request.Status != LeaveRequestStatus.Pending)">
                                            Approve
                                        </button>
                                    </form>

                                    @* Reject button *@
                                    <button type="button"
                                            class="btn btn-sm btn-danger"
                                            data-bs-toggle="modal"
                                            data-bs-target="#rejectModal"
                                            data-request-id="@request.Id"
                                            data-employee="@request.Employee.FirstName @request.Employee.LastName"
                                            disabled="@(request.Status != LeaveRequestStatus.Pending)">
                                        Reject
                                    </button>
                                }

                            </div>
                        </td>
                    </tr>
                }
            </tbody>

        </table>
    </div>
</div>

@* Shared reject modal - HR only *@
@if (User.IsInRole("HR"))
{
    <div class="modal fade" id="rejectModal" tabindex="-1"
         aria-labelledby="rejectModalLabel" aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">
            <form asp-action="Reject" method="post" class="modal-content">

                @Html.AntiForgeryToken()

                <input type="hidden" name="id" id="rejectRequestId" />

                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title" id="rejectModalLabel">
                        Reject leave request
                    </h5>

                    <button type="button" class="btn-close btn-close-white"
                            data-bs-dismiss="modal"
                            aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <p class="mb-2">
                        Rejecting request for
                        <strong id="rejectEmployee"></strong>.
                    </p>

                    <label for="reviewComment" class="form-label">
                        Rejection reason
                    </label>

                    <textarea name="remarks"
                              id="reviewComment"
                              class="form-control"
                              rows="3"
                              required
                              placeholder="Enter reason for rejection"></textarea>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit" class="btn btn-danger">
                        Reject
                    </button>
                </div>

            </form>
        </div>
    </div>
}

@section Scripts
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            // Initialize DataTable
            const table = new DataTable('#leaveRequestsTable', {
                paging: true,
                searching: true,
                ordering: true,
                pageLength: 10,
                lengthMenu: [10, 25, 50, 100],
                order: [[3, 'desc']],
                columnDefs: [
                    {
                        targets: 5,
                        orderable: false,
                        searchable: false
                    }
                ],
                language: {
                    search: "Search:",
                    lengthMenu: "Show _MENU_ entries",
                    info: "Showing _START_ to _END_ of _TOTAL_ leave requests",
                    emptyTable: "There are no leave requests yet.",
                    zeroRecords: "No matching leave requests found."
                }
            });

            // Leave Type filter
            document.getElementById('leaveTypeFilter')
                .addEventListener('change', function () {
                    table.column(1).search(this.value).draw();
                });

            // Status filter
            document.getElementById('statusFilter')
                .addEventListener('change', function () {
                    table.column(4).search(this.value).draw();
                });

            // Clear all filters and search
            document.getElementById('clearFilters')
                .addEventListener('click', function () {

                    document.getElementById('leaveTypeFilter').value = '';
                    document.getElementById('statusFilter').value = '';

                    table.search('').columns().search('').draw();
                });

            @if (User.IsInRole("HR"))
            {
                    <text>
                        // Reject modal handling
                        const rejectModal = document.getElementById("rejectModal");

                        if (rejectModal) {
                            rejectModal.addEventListener("show.bs.modal", function (event) {

                                const button = event.relatedTarget;

                                document.getElementById("rejectRequestId").value =
                                    button.getAttribute("data-request-id");

                                document.getElementById("rejectEmployee").textContent =
                                    button.getAttribute("data-employee");

                                document.getElementById("reviewComment").value = "";
                            });
                        }

                        // Automatically show pending requests popup
                        @if (pendingCount > 0)
                        {
                                <text>
                                    const pendingEl = document.getElementById("pendingLeaveModal");

                                    if (pendingEl && window.bootstrap) {
                                        new bootstrap.Modal(pendingEl).show();
                                    }
                                </text>
                        }
                    </text>
            }
        });
    </script>
}
