 @model IReadOnlyList<CodexaManagement.Model.Entities.LeaveRequest>
@using CodexaManagement.Model.Enum

@{
    ViewData["Title"] = "My Leave Requests";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">My Leave Requests</h2>
        <p class="text-muted mb-0">Track the status and HR comments for your requests.</p>
    </div>

    <a asp-action="Apply" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i>Apply for leave
    </a>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<div class="card border-0 shadow-sm">
    <div class="card-body">

       @* Filters *@
<div class="row mb-3 align-items-end">

    <div class="col-md-4 mb-2">
        <label class="form-label">Leave Type</label>
        <select id="leaveTypeFilter" class="form-select">
            <option value="">All Leave Types</option>
            <option value="Annual">Annual</option>
            <option value="Sick">Sick</option>
            <option value="Casual">Casual</option>
            <option value="Unpaid">Unpaid</option>
        </select>
    </div>

    <div class="col-md-4 mb-2">
        <label class="form-label">Status</label>
        <select id="statusFilter" class="form-select">
            <option value="">All Statuses</option>
            <option value="Pending">Pending</option>
            <option value="Approved">Approved</option>
            <option value="Rejected">Rejected</option>
        </select>
    </div>

    <div class="col-md-2 mb-2">
       <button type="button" id="clearFilters" class="btn btn-primary">
    <i class=""bi bi-plus-lg me-1"></i>Clear
</button>
    </div>

</div>

        @* Leave requests table *@
        <div class="table-responsive">
            <table id="myLeaveTable"
                   class="table table-bordered table-hover align-middle w-100">

                <thead class="table-light">
                    <tr>
                        <th>Leave Type</th>
                        <th>Dates</th>
                        <th>Working Days</th>
                        <th>Status</th>
                        <th>Proof</th>
                        <th>HR Comment</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var request in Model)
                    {
                        var days = 0;

                        for (var day = request.FromDate.Date;
                             day <= request.ToDate.Date;
                             day = day.AddDays(1))
                        {
                            if (day.DayOfWeek is not DayOfWeek.Saturday and not DayOfWeek.Sunday)
                            {
                                days++;
                            }
                        }

                        <tr>
                            <td>@request.LeaveType</td>

                            <td data-order="@request.FromDate.ToString("yyyy-MM-dd")">
                                @request.FromDate.ToString("d MMM yyyy")
                                –
                                @request.ToDate.ToString("d MMM yyyy")
                            </td>

                            <td>@days</td>

                            <td>
                                <span class="badge @(request.Status == LeaveRequestStatus.Approved
                                    ? "bg-success"
                                    : request.Status == LeaveRequestStatus.Rejected
                                        ? "bg-danger"
                                        : "bg-warning text-dark")">
                                    @request.Status
                                </span>
                            </td>

                            <td>
                                @if (request.OriginalFileName != null)
                                {
                                    <a asp-controller="Leave"
                                       asp-action="Proof"
                                       asp-route-id="@request.Id"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       class="btn btn-sm btn-outline-primary">
                                        View Proof
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>

                            <td>@(request.HRRemarks ?? "—")</td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const table = new DataTable('#myLeaveTable', {
                paging: true,
                searching: true,
                ordering: true,
                pageLength: 10,
                lengthMenu: [10, 25, 50, 100],
                order: [[1, 'desc']],
                language: {
                    emptyTable: "You have not submitted any leave requests.",
                    search: "Search:",
                    lengthMenu: "Show _MENU_ requests",
                    info: "Showing _START_ to _END_ of _TOTAL_ requests",
                    infoEmpty: "No leave requests available",
                    zeroRecords: "No matching leave requests found."
                }
            });

            // Leave Type filter
            document.getElementById('leaveTypeFilter')
                .addEventListener('change', function () {
                    table.column(0).search(this.value).draw();
                });

            // Status filter
            document.getElementById('statusFilter')
                .addEventListener('change', function () {
                    table.column(3).search(this.value).draw();
                });
                document.getElementById('clearFilters').addEventListener('click', function () {

    // Reset dropdowns
    document.getElementById('leaveTypeFilter').value = '';
    document.getElementById('statusFilter').value = '';

    // Clear DataTable filters and search
    table.search('').columns().search('').draw();
});

        });
    </script>
}