
@model CodexaManagement.Model.Entities.Employee

@{
    ViewData["Title"] = "Delete Employee";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-danger text-white">
            <h4 class="mb-0">Delete Employee</h4>
        </div>

        <div class="card-body">
            <div class="alert alert-warning">
                Are you sure you want to delete this employee?
            </div>

            <dl class="row">
                <dt class="col-sm-3">Employee ID</dt>
                <dd class="col-sm-9">@Model.Id</dd>

                <dt class="col-sm-3">First Name</dt>
                <dd class="col-sm-9">@Model.FirstName</dd>

                <dt class="col-sm-3">Last Name</dt>
                <dd class="col-sm-9">@Model.LastName</dd>

                <dt class="col-sm-3">Email</dt>
                <dd class="col-sm-9">@Model.Email</dd>

                <dt class="col-sm-3">Department</dt>
                <dd class="col-sm-9">@Model.Department</dd>

                <dt class="col-sm-3">Designation</dt>
                <dd class="col-sm-9">@Model.Designation</dd>

                <dt class="col-sm-3">Location</dt>
                <dd class="col-sm-9">@Model.Location</dd>
            </dl>

            <form asp-action="Delete"
      asp-controller="Employee"
      method="post"
      id="deleteEmployeeForm">

    @Html.AntiForgeryToken()

    <input type="hidden" name="id" value="@Model.Id" />

    <button type="button"
            class="btn btn-danger"
            id="confirmDeleteBtn">
        <i class="bi bi-trash"></i> Delete Employee
    </button>

    <a asp-action="Index"
       asp-controller="Employee"
       class="btn btn-secondary ms-2">
        Cancel
    </a>
</form>

@section Scripts {
    <script>
        document.getElementById("confirmDeleteBtn")
            .addEventListener("click", function () {
                Swal.fire({
                    title: "Are you sure?",
                    text: "This employee will be deleted.",
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonColor: "#d33",
                    cancelButtonColor: "#6c757d",
                    confirmButtonText: "Yes, delete",
                    cancelButtonText: "Cancel"
                }).then((result) => {
                    if (result.isConfirmed) {
                        document.getElementById("deleteEmployeeForm").submit();
                    }
                });
            });
    </script>
}