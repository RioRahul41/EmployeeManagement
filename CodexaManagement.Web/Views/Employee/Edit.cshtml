
@model CodexaManagement.Core.DTO.Employee.UpdateSalaryView

@{
    ViewData["Title"] = "Update Employee Salary";
}

<div class="container py-5">

    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5">

            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-header bg-white border-0 p-4 pb-0">
                    <div class="d-flex align-items-center gap-3">

                        <div class="rounded-3 bg-primary-subtle text-primary p-3">
                            <i class="bi bi-cash-stack fs-3"></i>
                        </div>

                        <div>
                            <h3 class="fw-bold mb-1">
                                Update Employee Salary
                            </h3>

                            <p class="text-muted small mb-0">
                                Update the employee's salary details.
                            </p>
                        </div>

                    </div>
                </div>

                <div class="card-body p-4">

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show"
                             role="alert">

                            <i class="bi bi-check-circle-fill me-2"></i>
                            @TempData["Success"]

                            <button type="button"
                                    class="btn-close"
                                    data-bs-dismiss="alert"
                                    aria-label="Close">
                            </button>
                        </div>
                    }

                    <form asp-controller="Employee"
                          asp-action="Edit"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        <input asp-for="Id" type="hidden" />

                        <div class="mb-4">
                            <label asp-for="Salary"
                                   class="form-label fw-semibold">
                                Salary
                            </label>

                            <div class="input-group">
                                <span class="input-group-text">₹</span>

                                <input asp-for="Salary"
                                       type="number"
                                       step="0.01"
                                       min="0.01"
                                       class="form-control"
                                       placeholder="Enter salary" />
                            </div>

                            <span asp-validation-for="Salary"
                                  class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary flex-fill">
                                <i class="bi bi-check-circle me-1"></i>
                                Update Salary
                            </button>

                            <a asp-controller="Employee"
                               asp-action="Index"
                               class="btn btn-outline-secondary">
                                Cancel
                            </a>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
