@model CodexaManagement.Model.Entities.Project

@{
    ViewData["Title"] = "Project Details";
}

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">@Model.ProjectName</h2>
            <p class="text-muted mb-0">Project details and timeline.</p>
        </div>

        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                <i class="bi bi-pencil me-1"></i>
                Edit
            </a>
            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">
                <i class="bi bi-trash me-1"></i>
                Delete
            </a>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <dl class="row mb-0">
                <dt class="col-sm-3 mb-3">Project name</dt>
                <dd class="col-sm-9 mb-3">@Model.ProjectName</dd>

                <dt class="col-sm-3 mb-3">Description</dt>
                <dd class="col-sm-9 mb-3">
                    @(string.IsNullOrWhiteSpace(Model.Description) ? "No description" : Model.Description)
                </dd>

                <dt class="col-sm-3 mb-3">Start date</dt>
                <dd class="col-sm-9 mb-3">@Model.StartDate.ToString("dd MMM yyyy")</dd>

                <dt class="col-sm-3 mb-3">End date</dt>
                <dd class="col-sm-9 mb-3">@(Model.EndDate?.ToString("dd MMM yyyy") ?? "Not set")</dd>

                <dt class="col-sm-3 mb-3">Status</dt>
                <dd class="col-sm-9 mb-3">
                    @if (Model.IsActive)
                    {
                        <span class="badge rounded-pill bg-success-subtle text-success px-3 py-2">Active</span>
                    }
                    else
                    {
                        <span class="badge rounded-pill bg-secondary-subtle text-secondary px-3 py-2">Inactive</span>
                    }
                </dd>

                <dt class="col-sm-3 mb-3">Created</dt>
                <dd class="col-sm-9 mb-3">@Model.CreatedTime.ToString("dd MMM yyyy, hh:mm tt")</dd>

                @if (Model.UpdatedTime.HasValue)
                {
                    <dt class="col-sm-3 mb-3">Last updated</dt>
                    <dd class="col-sm-9 mb-3">@Model.UpdatedTime.Value.ToString("dd MMM yyyy, hh:mm tt")</dd>
                }
            </dl>
        </div>
    </div>

    <a asp-action="Index" class="btn btn-outline-secondary mt-4">
        <i class="bi bi-arrow-left me-1"></i>
        Back to Projects
    </a>
</div>
