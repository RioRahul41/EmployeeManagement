@model CodexaManagement.Model.Entities.Project

@{
    ViewData["Title"] = "Delete Project";
}

<div class="container-fluid py-4">
    <div class="mb-4">
        <h2 class="fw-bold mb-1">Delete Project</h2>
        <p class="text-muted mb-0">Confirm that you want to remove this project.</p>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <div class="alert alert-warning" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                This project will be deactivated and removed from the active project list.
            </div>

            <dl class="row mb-4">
                <dt class="col-sm-3 mb-3">Project name</dt>
                <dd class="col-sm-9 mb-3">@Model.ProjectName</dd>

                <dt class="col-sm-3 mb-3">Description</dt>
                <dd class="col-sm-9 mb-3">
                    @(string.IsNullOrWhiteSpace(Model.Description) ? "No description" : Model.Description)
                </dd>

                <dt class="col-sm-3 mb-3">Start date</dt>
                <dd class="col-sm-9 mb-3">@Model.StartDate.ToString("dd MMM yyyy")</dd>
            </dl>

            <form asp-action="Delete" method="post">
                <input asp-for="Id" type="hidden" />
                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-trash me-1"></i>
                    Delete Project
                </button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary ms-2">Cancel</a>
            </form>
        </div>
    </div>
</div>
